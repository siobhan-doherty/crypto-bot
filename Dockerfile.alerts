FROM python:3.11-slim

WORKDIR /app

# install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# copy requirements first for better caching
COPY requirements-dev.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# install additional packages for sentiment and pattern analytics
RUN pip install --no-cache-dir scikit-learn pandas

# copy entire src folder, so alerts module is available
COPY src/ /app/src/

# copy scripts folder
COPY scripts/ /app/scripts/

# set PYTHONPATH
ENV PYTHONPATH=/app

# add health check (ONE LINE - no backslash)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD curl -f http://localhost:8080/health || exit 1

# run alert engine
CMD ["python", "/app/scripts/run_alerts.py"]
